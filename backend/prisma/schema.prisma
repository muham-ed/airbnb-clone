generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User model representing guests, hosts, and system administrators.
model User {
  /// Unique identifier for the user (UUID v4)
  id        String   @id @default(uuid())
  /// User's email address used for authentication (must be unique)
  email     String   @unique
  /// Hashed password for the user account
  password  String
  /// Display name of the user
  name      String
  /// Optional avatar / profile image URL
  avatar    String?
  /// Role determining user privileges (GUEST, HOST, ADMIN)
  role      UserRole @default(GUEST)
  /// Timestamp when the user account was created
  createdAt DateTime @default(now())
  /// Timestamp when the user account was last updated
  updatedAt DateTime @updatedAt

  /// Property listings created by this user (if host)
  listings  Listing[]
  /// Bookings made by this user (if guest)
  bookings  Booking[]
  /// Reviews written by this user
  reviews   Review[]
  /// Saved wishlists created by this user
  wishlists Wishlist[]
}

/// Enumeration of user roles for role-based access control.
enum UserRole {
  /// Guest user who can search and book listings
  GUEST
  /// Host user who can create and manage property listings
  HOST
  /// System administrator with full access permissions
  ADMIN
}

/// Property listing published by a host.
model Listing {
  /// Unique identifier for the listing (UUID v4)
  id          String   @id @default(uuid())
  /// Title or headline of the property
  title       String
  /// Detailed description of the property
  description String
  /// Price per night
  price       Float
  /// Human-readable location or address
  location    String
  /// Geographic latitude coordinate
  latitude    Float?
  /// Geographic longitude coordinate
  longitude   Float?
  /// Maximum number of guests allowed
  maxGuests   Int      @default(2)
  /// Number of bedrooms
  bedrooms    Int      @default(1)
  /// Number of beds
  beds        Int      @default(1)
  /// Number of bathrooms
  bathrooms   Float    @default(1.0)
  /// Mandatory cleaning fee amount
  cleaningFee Float    @default(0)
  /// List of image URLs associated with the listing
  images      String[]
  /// List of amenities (e.g. WiFi, Pool, Air Conditioning)
  amenities   String[]
  /// Availability flag indicating whether the listing accepts bookings
  available   Boolean  @default(true)
  /// ID of the host user who owns this listing
  hostId      String
  /// Relation to the host User
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// Timestamp when the listing was created
  createdAt   DateTime @default(now())
  /// Timestamp when the listing was last updated
  updatedAt   DateTime @updatedAt

  /// Bookings placed for this listing
  bookings      Booking[]
  /// Reviews left by guests for this listing
  reviews       Review[]
  /// Wishlist items featuring this listing
  wishlistItems WishlistItem[]
}

/// Booking reservation made by a guest for a property listing.
/// Note: A manual EXCLUDE CONSTRAINT was added in SQL migration to prevent overlapping booking dates for the same listing.
/// See: prisma/migrations/0_manual_booking_constraint/migration.sql
model Booking {
  /// Unique identifier for the booking (UUID v4)
  id          String   @id @default(uuid())
  /// ID of the property listing being booked
  listingId   String
  /// Relation to the booked Listing
  listing     Listing  @relation(fields: [listingId], references: [id])
  /// ID of the guest user making the booking
  guestId     String
  /// Relation to the guest User
  guest       User     @relation(fields: [guestId], references: [id])
  /// Check-in start date
  startDate   DateTime
  /// Check-out end date
  endDate     DateTime
  /// Total calculated price for the stay
  totalPrice  Float
  /// Currency code (e.g., "usd")
  currency    String   @default("usd")
  /// Current booking status ("pending", "confirmed", "cancelled")
  status      String   @default("pending")
  /// Timestamp when the booking was created
  createdAt   DateTime @default(now())
  /// Timestamp when the booking was last updated
  updatedAt   DateTime @updatedAt

  /// Optional review left for this booking
  review      Review?

  /// Payment transaction associated with this booking
  payment     Payment?
}

/// Payment record processed via Stripe for a booking.
model Payment {
  /// Unique identifier for the payment transaction (UUID v4)
  id                String   @id @default(uuid())
  /// ID of the booking associated with this payment
  bookingId         String   @unique
  /// Relation to the associated Booking
  booking           Booking  @relation(fields: [bookingId], references: [id])
  /// Unique Stripe Checkout session ID
  stripeSessionId   String   @unique
  /// Total payment amount
  amount            Float
  /// Currency code (e.g., "usd")
  currency          String   @default("usd")
  /// Payment status ("pending", "succeeded", "failed")
  status            String
  /// Timestamp when the payment record was created
  createdAt         DateTime @default(now())
  /// Timestamp when the payment record was last updated
  updatedAt         DateTime @updatedAt
}

/// Guest review and rating left for a completed stay.
model Review {
  /// Unique identifier for the review (UUID v4)
  id          String   @id @default(uuid())
  /// Numerical rating score (1–5)
  rating      Int
  /// Textual feedback / comments
  comment     String
  /// ID of the user writing the review
  userId      String
  /// Relation to the author User
  user        User     @relation(fields: [userId], references: [id])
  /// ID of the listing being reviewed
  listingId   String
  /// Relation to the reviewed Listing
  listing     Listing  @relation(fields: [listingId], references: [id])
  /// ID of the completed booking being reviewed
  bookingId   String   @unique
  /// Relation to the associated Booking
  booking     Booking  @relation(fields: [bookingId], references: [id])
  /// Timestamp when the review was created
  createdAt   DateTime @default(now())
}

/// Wishlist container created by a user to organize favorite listings.
model Wishlist {
  /// Unique identifier for the wishlist (UUID v4)
  id        String         @id @default(uuid())
  /// ID of the user who owns this wishlist
  userId    String
  /// Relation to the owner User
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Name of the wishlist (e.g., "Summer Trip", "Dream Homes")
  name      String
  /// Wishlist items contained in this wishlist
  items     WishlistItem[]
  /// Timestamp when the wishlist was created
  createdAt DateTime       @default(now())
  /// Timestamp when the wishlist was last updated
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

/// Individual listing saved inside a user's wishlist.
model WishlistItem {
  /// Unique identifier for the wishlist item (UUID v4)
  id         String   @id @default(uuid())
  /// ID of the parent wishlist
  wishlistId String
  /// Relation to the parent Wishlist
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  /// ID of the saved listing
  listingId  String
  /// Relation to the saved Listing
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Timestamp when the item was added
  addedAt    DateTime @default(now())

  @@unique([wishlistId, listingId])
}
